/target
Cargo.lock
# Exception: avr-nano-tamer is a firmware binary package, excluded from the workspace, and
# depends on avr-hal by git. Its lockfile pins that dependency set, so `--locked` CI needs it.
!examples/avr-nano-tamer/Cargo.lock
.embuild/
.cargo/config.toml

# --- Developer-local / AI-tooling — never commit (this is a PUBLIC repo) ---
# Only AGENTS.md (the generic, cross-tool agent guide) is committed. All
# Claude-specific config and instructions stay private. See the "Repository
# Privacy Policy" in CLAUDE.md. Do NOT un-ignore these paths, regardless of any
# onboarding / settings-cleanup skill that suggests tracking .claude/ agents.
.claude/
CLAUDE.md
memory/
review-queue/
release/
audit/
.idea/
.envrc
.codex/

# Temporary scratch files — local only
tmp/

# bench run artefacts (rustyfarian-bench): per-run serial logs
bench/*/logs/
bench/*/results.jsonl
